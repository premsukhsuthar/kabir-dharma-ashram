{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Kabir Dharma Ashram & Trust</title>
    <link rel="stylesheet" href="{% static 'css/style.css' %}">

</head>
<body>

<header class="navbar">
    <div class="logo">
        🛕 Kabir Dharma Ashram
    </div>

    <nav>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/kabir/">Kabir Sahib</a></li>
            <li><a href="/ashram/">Ashram</a></li>
            <li><a href="/trust/">Trust</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/events/">Events</a></li>

        </ul>
    </nav>
</header>

    <li><a href="/gallery/">Gallery</a></li>

    <main class="content">
        {% block content %}{% endblock %}
    </main>

    <footer>
        <p>© Kabir Dharma Ashram & Trust</p>
    </footer>

</body>
</html>

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #fff3d6;
    padding: 15px 40px;
    border-bottom: 2px solid #e0c68f;
}

/* Logo */
.logo {
    font-size: 22px;
    font-weight: bold;
}

/* Links */
.nav-links {
    list-style: none;
    display: flex;
    gap: 25px;
}

.nav-links li a {
    text-decoration: none;
    color: #5a3b1e;
    font-weight: 500;
}

.nav-links li a:hover {
    color: #b86b00;
    border-bottom: 2px solid #b86b00;
    padding-bottom: 3px;
}

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 30px;
}

.gallery-item {
    background: #fff;
    padding: 10px;
    border: 1px solid #ddd;
    color: aqua;
}

.gallery-item img {
    width: 100%;
    height: auto;
}